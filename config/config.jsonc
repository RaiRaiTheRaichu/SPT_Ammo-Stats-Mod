{
  /*
  / Valid values are "prepend" or "append".
  / Prepend will cause the information to appear at the beginning of the description.
  / Append will add the information to the end.
  */
  "mode": "prepend",

  /*
  / Valid values are "oneline" or "newline".
  / Oneline will add all values on one line separated by pipes ( | )
  / Newline will place each value on a new line.
  */
  "separator": "newline",

  // The following three options are now set to false by default, thanks to BSG adding official ammo stat displays to bullets.
  "bulletStats": {
    // "true" will add the damage of the ammunition to the description of the bullet.
    "addDamage": false,
    // "true" will add the penetration of the ammunition to the description of the bullet.
    "addPen": false,
    // "true" will add the calculated armor level efficacy to the description of the bullet.
    "addEffectArmorLv": false
  },

  // Set this to true and the penetration level will be shown in the bullet name.
  // This will also allow you to see the armor level it will penetrate when doing a mag check.
  "showPenInName": false,

  // If this is set to true, the background colors of bullets will be color-coded based on the armor level they are effective against.
  "enableBulletColoredIcons": true,
  // If this is set to true, the background colors of ammo boxes will be color-coded based on the effective armor level of the bullet they contain.
  "enableBoxesColoredIcons": true,

  /*
  / If you are NOT using the Color Converter API plugin, you can choose from the following colors:
  / default, red, orange, yellow, green, blue, violet, grey, black
  */
  "backgroundColors": {
    "0": "red",
    "1": "red",
    "2": "orange",
    "3": "yellow",
    "4": "green",
    "5": "blue",
    "6": "violet"
  },

  // The options below require the Color Converter plugin to function, otherwise they do nothing!
  "enableExtendedBackgroundColors": true,

  /*
  / Select a color profile/customize a profile here.
  / Valid options: Custom, Rainbow, Grayscale, GrayscaleInverted
  */
  "colorProfile": "Rainbow",
  "colorProfiles": {
    "Custom": {
      "0": "#A10000",
      "1": "#A10000",
      "2": "#A15000",
      "3": "#A1A100",
      "4": "#416600",
      "5": "#008282",
      "6": "#6A006A"
    },
    "Rainbow": {
      "0": "#A10000",
      "1": "#A10000",
      "2": "#A15000",
      "3": "#A1A100",
      "4": "#416600",
      "5": "#008282",
      "6": "#6A006A"
    },
    "Grayscale": {
      "0": "#333333",
      "1": "#333333",
      "2": "#585858",
      "3": "#7A7A7A",
      "4": "#9E9E9E",
      "5": "#B0B0B0",
      "6": "#D2D2D2"
    },
    "GrayscaleInverted": {
      "0": "#D2D2D2",
      "1": "#D2D2D2",
      "2": "#B0B0B0",
      "3": "#9E9E9E",
      "4": "#7A7A7A",
      "5": "#585858",
      "6": "#333333"
    }
  },
